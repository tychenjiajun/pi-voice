{
  "name": "@tychenjiajun/pi-voice",
  "version": "0.8.1",
  "description": "Speech-to-text for the Pi coding agent: press a shortcut and dictate — transcripts land directly in your chat. Local models (Whisper, Parakeet) or any OpenAI-compatible remote ASR endpoint, with compaction-style post-processing that strips fillers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-voice.git"
  },
  "homepage": "https://pi.dev/packages/@tychenjiajun/pi-voice",
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-voice/issues"
  },
  "files": [
    "src",
    "index.ts",
    "catalog/catalog.json",
    "catalog/recommendations.json",
    "models/silero-vad-v6.2-F32.gguf",
    "models/README.md",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "transcription",
    "speech-to-text",
    "asr",
    "whisper",
    "openai-compatible",
    "voice-input",
    "voice-control",
    "local-model"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node scripts/run-tests.mjs",
    "prepublishOnly": "npm test",
    "recommendations:generate": "node scripts/generate-recommendations.mjs",
    "catalog:verify": "node scripts/catalog-metadata.mjs",
    "catalog:update-metadata": "node scripts/catalog-metadata.mjs --write"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tychenjiajun/pi-voice/remote-asr-backend/assets/preview.png",
    "video": "https://raw.githubusercontent.com/tychenjiajun/pi-voice/remote-asr-backend/assets/demo.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@huggingface/gguf": "^0.4.6",
    "@types/node": "22.20.1",
    "typebox": "^1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1",
    "@huggingface/hub": "2.15.0",
    "openai": "^7.31.0",
    "opencc-js": "^1.4.1",
    "transcribe-cpp": "0.4.0"
  }
}
